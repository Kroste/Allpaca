{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "detail": "F5-Build: nur Allpaca.csproj in Debug. Spart die Tests-Compile-Sekunden vor jedem Start.",
      "args": [
        "build",
        "${workspaceFolder}/Allpaca/Allpaca.csproj",
        "-c",
        "Debug",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "build (full solution)",
      "command": "dotnet",
      "type": "process",
      "detail": "Kompletter Solution-Build inkl. Tests-Projekt.",
      "args": [
        "build",
        "${workspaceFolder}/Allpaca.slnx",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "command": "dotnet",
      "type": "process",
      "args": [ "test", "${workspaceFolder}/Allpaca.slnx" ],
      "problemMatcher": "$msCompile",
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "run (no debug)",
      "type": "shell",
      "detail": "Fällt zurück auf 'dotnet run', wenn der C#-Debugger fehlt oder F5 streikt. Kein Debugger-Attach, dafür immer da.",
      "command": "dotnet",
      "args": [ "run", "--project", "${workspaceFolder}/Allpaca/Allpaca.csproj" ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "clean",
      "command": "dotnet",
      "type": "process",
      "args": [ "clean", "${workspaceFolder}/Allpaca.slnx" ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "rebuild",
      "dependsOrder": "sequence",
      "dependsOn": [ "clean-hard", "build" ],
      "problemMatcher": []
    },
    {
      "label": "clean-hard",
      "type": "shell",
      "detail": "Löscht ALLE bin/ und obj/ rekursiv vom Datenträger (gegen hängenden Avalonia-XAML-Cache im obj/).",
      "command": "find . -type d \\( -name bin -o -name obj \\) -exec rm -rf {} +",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "release (tag + push)",
      "type": "shell",
      "detail": "Fragt die neue Version ab (MinVer: letzter Tag + Bump), taggt vX.Y.Z und pusht -> löst den Release-Workflow aus.",
      "command": "bash scripts/release.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
