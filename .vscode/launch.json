{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Allpaca (Debug)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Allpaca/bin/Debug/net10.0/Allpaca.dll",
      "args": [],
      "cwd": "${workspaceFolder}/Allpaca",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "env": {
        "DOTNET_ENVIRONMENT": "Development",
        "AVALONIA_NO_TELEMETRY": "1"
      }
    },
    {
      "name": ".NET: An laufenden Prozess anhaengen",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}
