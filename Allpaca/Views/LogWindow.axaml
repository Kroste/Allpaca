<chrome:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:Allpaca.Chrome"
        xmlns:vm="clr-namespace:Allpaca.ViewModels"
        xmlns:m="clr-namespace:Allpaca.Models"
        x:Class="Allpaca.Views.LogWindow"
        x:DataType="vm:LogWindowViewModel"
        Title="Operation"
        Width="780" Height="540"
        MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="#1B1D21">

    <Grid RowDefinitions="40,Auto,*,Auto,Auto">

        <!-- Titelleiste -->
        <Grid Grid.Row="0" Background="#15171A" ColumnDefinitions="*,Auto"
              PointerPressed="OnTitleBarPointerPressed">
            <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="#EDEFF2"
                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0"
                       TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="1" Classes="chrome close" Content="✕"
                    Click="OnCloseClick"/>
        </Grid>

        <!-- Statusleiste -->
        <Border Grid.Row="1" Background="#202329" Padding="14,8" Margin="10,10,10,0"
                CornerRadius="8">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="10" Height="10" CornerRadius="5"
                        Background="{Binding StatusBrush}"/>
                <TextBlock Text="{Binding StatusText}" Foreground="#EDEFF2"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Live-Log -->
        <Border Grid.Row="2" Background="#15171A" Margin="10,10,10,0" CornerRadius="8"
                ClipToBounds="True">
            <ScrollViewer x:Name="LogScroll" Padding="10"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Lines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:ProgressLine">
                            <TextBlock Text="{Binding Text}" FontFamily="monospace"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{Binding IsError, Converter={x:Static vm:ProgressLineConverters.ErrorOrNormal}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Reboot-Hinweis (z. B. nach rpm-ostree-Aenderung) -->
        <Border Grid.Row="3" Background="#3A2F1B" CornerRadius="8"
                Padding="14,10" Margin="10,10,10,0"
                IsVisible="{Binding ShowRebootHint}">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="⚠" Foreground="#F5A623" FontSize="16"
                           VerticalAlignment="Center"/>
                <TextBlock Foreground="#F5A623" FontSize="13" VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Text="Neustart erforderlich – die Änderung wirkt erst nach einem Reboot vollständig."/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="8" Margin="10,12,10,12">
            <Button Classes="danger" Content="Abbrechen"
                    Command="{Binding CancelCommand}"/>
            <Button Classes="accent" Content="Schließen"
                    Command="{Binding CloseCommand}"/>
        </StackPanel>
    </Grid>
</chrome:ChromeWindow>
