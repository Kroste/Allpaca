<chrome:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:Allpaca.Chrome"
        xmlns:vm="clr-namespace:Allpaca.ViewModels"
        xmlns:m="clr-namespace:Allpaca.Models"
        x:Class="Allpaca.Views.SearchWindow"
        x:DataType="vm:SearchWindowViewModel"
        Title="Installieren"
        Width="820" Height="620"
        MinWidth="540" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="#1B1D21">

    <Grid RowDefinitions="40,Auto,Auto,*,Auto">

        <!-- Titelleiste -->
        <Grid Grid.Row="0" Background="#15171A" ColumnDefinitions="*,Auto"
              PointerPressed="OnTitleBarPointerPressed">
            <TextBlock Grid.Column="0" Text="Installieren" Foreground="#EDEFF2"
                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0"/>
            <Button Grid.Column="1" Classes="chrome close" Content="✕" Click="OnCloseClick"/>
        </Grid>

        <!-- Suchleiste -->
        <Grid Grid.Row="1" Margin="14,12" ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" Text="{Binding Query}"
                     PlaceholderText="Was möchtest du installieren?"
                     KeyDown="OnQueryKeyDown"/>
            <Button Grid.Column="1" Classes="accent" Content="Suchen"
                    Command="{Binding SearchCommand}" Margin="10,0,0,0"/>
        </Grid>

        <!-- Quellen-Filter -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="14"
                    Margin="14,0,14,10">
            <TextBlock Text="Quellen:" Foreground="#9AA0A8" VerticalAlignment="Center"/>
            <CheckBox IsChecked="{Binding IncludeFlatpak}" Content="Flatpak"
                      Foreground="#C7CCD2"/>
            <CheckBox IsChecked="{Binding IncludeHomebrew}" Content="Homebrew"
                      Foreground="#C7CCD2"/>
            <TextBlock Text="rpm-ostree-Installation folgt – braucht Polkit-Sonderbehandlung."
                       Foreground="#6E747C" FontSize="11" VerticalAlignment="Center"
                       FontStyle="Italic"/>
        </StackPanel>

        <!-- Trefferliste -->
        <Border Grid.Row="3" Background="#202329" CornerRadius="10"
                Margin="10,0,10,10" ClipToBounds="True">
            <Grid>
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsSearching}"
                             VerticalAlignment="Top" Height="3" Background="Transparent"
                             Foreground="#2BB673" ZIndex="1"/>

                <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}"
                         Background="Transparent" BorderThickness="0" Padding="6">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="m:PackageInfo">
                            <Grid ColumnDefinitions="*,Auto" Margin="6,3">
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="#EDEFF2" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Source}" Foreground="#6E747C"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Id}" Foreground="#6E747C"
                                               FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Description}" Foreground="#9AA0A8"
                                               FontSize="12" TextWrapping="Wrap"
                                               MaxLines="2"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Origin}"
                                           Foreground="#6E747C" FontSize="11"
                                           VerticalAlignment="Center" Margin="8,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" Margin="14,8,14,14">
            <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="#9AA0A8"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Schließen" Click="OnCloseClick"
                    Margin="0,0,8,0"/>
            <Button Grid.Column="2" Classes="accent" Content="Installieren"
                    Command="{Binding InstallCommand}"/>
        </Grid>
    </Grid>
</chrome:ChromeWindow>
