<chrome:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:Allpaca.Chrome"
        xmlns:vm="clr-namespace:Allpaca.ViewModels"
        x:Class="Allpaca.Views.OllamaPullWindow"
        x:DataType="vm:OllamaPullViewModel"
        Title="Modell wird geladen"
        Width="520" Height="280"
        MinWidth="420" MinHeight="220"
        WindowStartupLocation="CenterOwner"
        Background="#1B1D21">

    <Grid RowDefinitions="40,*,Auto">

        <!-- Titelleiste -->
        <Grid Grid.Row="0" Background="#15171A" ColumnDefinitions="*,Auto"
              PointerPressed="OnTitleBarPointerPressed">
            <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="#EDEFF2"
                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0"
                       TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="1" Classes="chrome close" Content="✕" Click="OnCloseClick"/>
        </Grid>

        <!-- Inhalt -->
        <StackPanel Grid.Row="1" Margin="22,18" Spacing="14" VerticalAlignment="Center">
            <TextBlock Text="{Binding ModelName}" Foreground="#EDEFF2"
                       FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding StatusText}" Foreground="#C7CCD2"
                       FontSize="13" TextWrapping="Wrap"/>
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue}"
                         IsIndeterminate="{Binding !HasProgress}"
                         Foreground="#2BB673" Height="6"/>
        </StackPanel>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="8" Margin="14,8,14,14">
            <Button Classes="danger" Content="Abbrechen"
                    Command="{Binding CancelCommand}"/>
            <Button Classes="accent" Content="Schließen"
                    Command="{Binding CloseCommand}"/>
        </StackPanel>
    </Grid>
</chrome:ChromeWindow>
