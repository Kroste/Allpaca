<chrome:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:Allpaca.Chrome"
        xmlns:vm="clr-namespace:Allpaca.ViewModels"
        xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
        x:Class="Allpaca.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Allpaca" Width="1140" Height="740"
        Background="#1B1D21">

    <Grid RowDefinitions="40,Auto,Auto,*">

        <!-- ====== Titelleiste ====== -->
        <Grid Grid.Row="0" Background="#15171A"
              ColumnDefinitions="Auto,*,Auto"
              PointerPressed="OnTitleBarPointerPressed">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                        Margin="14,0" VerticalAlignment="Center">
                <Border Width="16" Height="16" CornerRadius="4" Background="#2BB673"/>
                <TextBlock Text="Allpaca" FontWeight="SemiBold" Foreground="#EDEFF2"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Paketverwaltung für Bazzite" Foreground="#6E747C"
                           FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Classes="chrome" Content="—" Click="OnMinimizeClick"/>
                <Button Classes="chrome" Content="▢" Click="OnMaximizeClick"/>
                <Button Classes="chrome close" Content="✕" Click="OnCloseClick"/>
            </StackPanel>
        </Grid>

        <!-- ====== Werkzeugleiste ====== -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="14,12">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14"
                        VerticalAlignment="Center">
                <TextBox Text="{Binding SearchText}"
                         PlaceholderText="Pakete durchsuchen…"
                         Width="380"/>
                <TextBlock Text="Sortieren:" Foreground="#9AA0A8" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding SortOptions}"
                          SelectedItem="{Binding SelectedSortOption}"
                          Width="130">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SortOption">
                            <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="{Binding SortDirectionGlyph}"
                        Command="{Binding ToggleSortDirectionCommand}"
                        ToolTip.Tip="Sortierrichtung umschalten"
                        Width="40"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding CountSummary}" Foreground="#9AA0A8"
                           VerticalAlignment="Center"/>
                <Button Content="+ Installieren …" Command="{Binding OpenInstallCommand}"/>
                <Button Classes="accent" Content="Aktualisieren"
                        Command="{Binding RefreshCommand}"/>
                <Button Content="ⓘ Info" Click="OnInfoClick"/>
            </StackPanel>
        </Grid>

        <!-- ====== rpm-ostree OS-Update-Banner ====== -->
        <Border Grid.Row="2" Background="#3A2F1B" CornerRadius="10"
                Padding="14,10" Margin="14,0,14,12"
                IsVisible="{Binding HasOsUpdate}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
                <TextBlock Grid.Column="0" Text="⬆" Foreground="#F5A623"
                           FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" Foreground="#F5A623" VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Text="{Binding OsUpdateMessage, StringFormat='rpm-ostree: OS-Update verfügbar ({0}). Erfordert einen Neustart.'}"/>
                <Button Grid.Column="2" Classes="accent" Content="Jetzt aktualisieren"
                        Command="{Binding ApplyOsUpdateCommand}" Margin="10,0,0,0"/>
                <Button Grid.Column="3" Content="✕"
                        Command="{Binding DismissOsUpdateCommand}"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#F5A623" Margin="6,0,0,0"
                        ToolTip.Tip="Hinweis für diese Sitzung ausblenden"/>
            </Grid>
        </Border>

        <!-- ====== Inhalt ====== -->
        <Grid Grid.Row="3" ColumnDefinitions="240,*,320" Margin="14,0,14,14">

            <!-- Quellen-Filter -->
            <Border Grid.Column="0" Background="#202329" CornerRadius="10"
                    Padding="8" Margin="0,0,10,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="QUELLEN" Foreground="#6E747C"
                               FontSize="11" FontWeight="SemiBold" Margin="8,6,8,10"/>
                    <StackPanel DockPanel.Dock="Bottom" Margin="8,10,8,2">
                        <Border Background="#2A2E35" Height="1" Margin="0,0,0,10"/>
                        <TextBlock Text="OPTIONEN" Foreground="#6E747C" FontSize="11"
                                   FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <CheckBox IsChecked="{Binding ShowRuntimes}"
                                  Content="Flatpak-Runtimes anzeigen"
                                  Foreground="#C7CCD2"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Filters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SourceFilterViewModel">
                                <Border Padding="8,6" Margin="0,2" CornerRadius="8">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" VerticalAlignment="Center">
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                  VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Width="10" Height="10" CornerRadius="3"
                                                Background="{Binding Brush}" Margin="2,0,8,0"
                                                VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" Foreground="#EDEFF2"/>
                                            <TextBlock Text="{Binding Status}" Foreground="#E25555"
                                                       FontSize="11" IsVisible="{Binding !IsAvailable}"/>
                                        </StackPanel>
                                        <Border Grid.Column="3" Background="#2A2E35" CornerRadius="9"
                                                Padding="7,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Count}" Foreground="#9AA0A8"
                                                       FontSize="12"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- Paketliste -->
            <Border Grid.Column="1" Background="#202329" CornerRadius="10" Margin="0,0,10,0"
                    ClipToBounds="True">
                <Grid RowDefinitions="Auto,*">
                    <!-- Batch-Banner: erscheint, sobald 2+ Eintraege markiert sind -->
                    <Border Grid.Row="0" Background="#262E36" CornerRadius="8"
                            Padding="12,6" Margin="6,6,6,0"
                            IsVisible="{Binding HasMultiSelection}">
                        <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" Text="{Binding BatchInfo}"
                                       Foreground="#C7CCD2" VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                            <Button Grid.Column="1" Content="Aktualisieren"
                                    Command="{Binding BatchUpdateSelectedCommand}"
                                    Margin="8,0,0,0"/>
                            <Button Grid.Column="2" Classes="danger" Content="Deinstallieren"
                                    Command="{Binding BatchUninstallSelectedCommand}"
                                    Margin="8,0,0,0"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}"
                                     VerticalAlignment="Top" Height="3" Background="Transparent"
                                     Foreground="#2BB673" ZIndex="1"/>
                        <ListBox x:Name="PackagesList"
                                 ItemsSource="{Binding Packages}" SelectedItem="{Binding Selected}"
                                 SelectionMode="Multiple"
                                 SelectionChanged="OnPackagesSelectionChanged"
                                 Background="Transparent" BorderThickness="0" Padding="6">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PackageItemViewModel">
                                <Grid ColumnDefinitions="4,*,Auto,Auto,Auto">
                                    <Border Grid.Column="0" Width="4" CornerRadius="2"
                                            Background="{Binding SourceBrush}"/>
                                    <StackPanel Grid.Column="1" Margin="10,3">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Name}" Foreground="#EDEFF2"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="⚠" Foreground="#F5A623"
                                                       FontSize="13" VerticalAlignment="Center"
                                                       IsVisible="{Binding IsDuplicate}"
                                                       ToolTip.Tip="{Binding DuplicateInfo, StringFormat='Auch verfügbar in: {0}'}"/>
                                            <Border Background="#1E3527" CornerRadius="6"
                                                    Padding="6,1" VerticalAlignment="Center"
                                                    IsVisible="{Binding HasUpdate}"
                                                    ToolTip.Tip="Update verfügbar">
                                                <TextBlock Text="↑ Update" Foreground="#2BB673"
                                                           FontSize="11"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Id}" Foreground="#6E747C"
                                                   FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Version}"
                                               Foreground="#9AA0A8" VerticalAlignment="Center"
                                               Margin="8,0"/>
                                    <Border Grid.Column="3"
                                            Background="{Binding DistroboxStatusBackground}"
                                            CornerRadius="6" Padding="7,2"
                                            VerticalAlignment="Center" Margin="8,0,0,0"
                                            IsVisible="{Binding DistroboxStatus, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="{Binding DistroboxStatus}"
                                                   Foreground="{Binding DistroboxStatusForeground}"
                                                   FontSize="11"/>
                                    </Border>
                                    <Border Grid.Column="4" Background="#2A2E35" CornerRadius="6"
                                            Padding="7,2" VerticalAlignment="Center" Margin="8,0,4,0">
                                        <TextBlock Text="{Binding SourceLabel}"
                                                   Foreground="{Binding SourceBrush}" FontSize="11"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <!-- Detailpanel -->
            <Border Grid.Column="2" Background="#202329" CornerRadius="10" Padding="16">
                <Panel>
                    <!-- Platzhalter, wenn nichts gewaehlt -->
                    <TextBlock Text="Eintrag auswählen für Details"
                               Foreground="#6E747C" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding Selected, Converter={x:Static conv:ObjectConverters.IsNull}}"/>

                    <ScrollViewer IsVisible="{Binding Selected, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{Binding Selected.Name}" Foreground="#EDEFF2"
                                       FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                            <Border Background="#2A2E35" CornerRadius="6" Padding="8,3"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Selected.SourceLabel}"
                                           Foreground="{Binding Selected.SourceBrush}"/>
                            </Border>

                            <StackPanel Spacing="3"
                                        IsVisible="{Binding Selected.DistroboxStatus, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="STATUS" Foreground="#6E747C" FontSize="11"/>
                                <Border Background="{Binding Selected.DistroboxStatusBackground}"
                                        CornerRadius="6" Padding="8,3"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Selected.DistroboxStatus}"
                                               Foreground="{Binding Selected.DistroboxStatusForeground}"
                                               FontSize="13"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="3" IsVisible="{Binding Selected.HasUpdate}">
                                <TextBlock Text="UPDATE" Foreground="#6E747C" FontSize="11"/>
                                <Border Background="#1E3527" CornerRadius="6" Padding="8,3"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="↑ Update verfügbar" Foreground="#2BB673"
                                               FontSize="13"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="3" IsVisible="{Binding Selected.IsDuplicate}">
                                <TextBlock Text="AUCH VERFÜGBAR IN" Foreground="#6E747C" FontSize="11"/>
                                <Border Background="#3A2F1B" CornerRadius="6" Padding="8,3"
                                        HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="⚠" Foreground="#F5A623" FontSize="13"/>
                                        <TextBlock Text="{Binding Selected.DuplicateInfo}"
                                                   Foreground="#F5A623" FontSize="13"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="3"
                                        IsVisible="{Binding Selected.Id, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="ID" Foreground="#6E747C" FontSize="11"/>
                                <TextBlock Text="{Binding Selected.Id}" Foreground="#C7CCD2"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Spacing="3"
                                        IsVisible="{Binding Selected.Version, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="VERSION" Foreground="#6E747C" FontSize="11"/>
                                <TextBlock Text="{Binding Selected.Version}" Foreground="#C7CCD2"/>
                            </StackPanel>
                            <StackPanel Spacing="3"
                                        IsVisible="{Binding Selected.Scope, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="ART / SCOPE" Foreground="#6E747C" FontSize="11"/>
                                <TextBlock Text="{Binding Selected.Scope}" Foreground="#C7CCD2"/>
                            </StackPanel>
                            <StackPanel Spacing="3"
                                        IsVisible="{Binding Selected.SizeText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="GRÖSSE" Foreground="#6E747C" FontSize="11"/>
                                <TextBlock Text="{Binding Selected.SizeText}" Foreground="#C7CCD2"/>
                            </StackPanel>
                            <StackPanel Spacing="3"
                                        IsVisible="{Binding Selected.Origin, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="HERKUNFT" Foreground="#6E747C" FontSize="11"/>
                                <TextBlock Text="{Binding Selected.Origin}" Foreground="#C7CCD2"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Spacing="3"
                                        IsVisible="{Binding Selected.Description, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="BESCHREIBUNG" Foreground="#6E747C" FontSize="11"/>
                                <TextBlock Text="{Binding Selected.Description}" Foreground="#C7CCD2"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <Border Height="1" Background="#2A2E35" Margin="0,4"/>

                            <TextBlock Text="Verdrahtet: Flatpak, rpm-ostree, Homebrew, Distrobox (Container), AppImage."
                                       Foreground="#6E747C" FontSize="12" FontStyle="Italic"
                                       TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Aktualisieren"
                                        Command="{Binding UpdateSelectedCommand}"/>
                                <Button Classes="danger" Content="Deinstallieren"
                                        Command="{Binding UninstallSelectedCommand}"/>
                            </StackPanel>
                            <Button Content="Pakete im Container anzeigen"
                                    Command="{Binding ShowContainerPackagesCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    IsVisible="{Binding Selected.IsDistrobox}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Panel>
            </Border>
        </Grid>
    </Grid>
</chrome:ChromeWindow>
