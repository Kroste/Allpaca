<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Allpaca.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme />

        <!-- Fensterknöpfe (Custom Chrome) -->
        <Style Selector="Button.chrome">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#C7CCD2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.chrome:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A2E35" />
        </Style>
        <Style Selector="Button.chrome.close:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#C0392B" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Akzent-Button. FluentTheme bringt selbst einen Button.accent-Style mit
             eigenem ControlTemplate mit, dessen Background unsere Setter ignoriert.
             Deshalb hier explizit den ContentPresenter im Template einfärben. -->
        <Style Selector="Button.accent">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.accent /template/ ContentPresenter">
            <Setter Property="Background" Value="#2BB673" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#26A267" />
        </Style>
        <Style Selector="Button.accent:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#1F8E5A" />
        </Style>

        <!-- Gefahr-Button (v2) -->
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#3A2326" />
            <Setter Property="Foreground" Value="#E57373" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,6" />
        </Style>

        <!-- Listeneinträge -->
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="6" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="2,1" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#27352F" />
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#242830" />
        </Style>
    </Application.Styles>
</Application>
