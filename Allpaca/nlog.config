<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true" internalLogLevel="Off">
  <!-- ${masked:inner=...} kommt aus Allpaca.Logging.MaskingLayoutRenderer und
       registriert sich über einen [ModuleInitializer]. WICHTIG: auch die Exception
       läuft durch den Filter - Gemini hängt seinen Key als ?key=... an die URL, und
       die URL steht in der HttpRequestException. -->
  <targets>
    <!-- Datei ab Trace: im Zweifel loggen. Ein Tag pro Datei über ${shortdate}. -->
    <target xsi:type="File" name="file"
            fileName="${specialfolder:folder=ApplicationData}/Allpaca/logs/allpaca-${shortdate}.log"
            archiveEvery="Day" maxArchiveFiles="14"
            layout="${longdate} ${level:uppercase=true} ${logger:shortName=true} ${masked:inner=${message}} ${masked:inner=${exception:format=tostring}}" />
    <target xsi:type="Console" name="console"
            layout="${time} ${level:uppercase=true} ${logger:shortName=true} ${masked:inner=${message}}" />
  </targets>
  <rules>
    <logger name="*" minlevel="Trace" writeTo="file" />
    <logger name="*" minlevel="Info" writeTo="console" />
  </rules>
</nlog>
