<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true" internalLogLevel="Off">
  <!-- ${masked:...} kommt aus Allpaca.Logging.MaskingLayoutRenderer und wird in
       Program.Main registriert, BEVOR der erste Logger gezogen wird. Ohne die
       Registrierung greift der Renderer nicht. -->
  <targets>
    <!-- Datei ab Trace: im Zweifel loggen. Ein Tag pro Datei über ${shortdate}. -->
    <target xsi:type="File" name="file"
            fileName="${specialfolder:folder=ApplicationData}/Allpaca/logs/allpaca-${shortdate}.log"
            archiveEvery="Day" maxArchiveFiles="14"
            layout="${longdate} ${level:uppercase=true} ${logger:shortName=true} ${masked} ${exception:format=tostring}" />
    <target xsi:type="Console" name="console"
            layout="${time} ${level:uppercase=true} ${logger:shortName=true} ${masked}" />
  </targets>
  <rules>
    <logger name="*" minlevel="Trace" writeTo="file" />
    <logger name="*" minlevel="Info" writeTo="console" />
  </rules>
</nlog>
