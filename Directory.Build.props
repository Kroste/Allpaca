<Project>
  <!-- Kroste-Standard: gemeinsame Build-Einstellungen für alle Projekte im Repo.
       Einzelne csproj-Dateien wiederholen nichts davon. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Authors>Lars Oste</Authors>
    <RepositoryUrl>https://github.com/Kroste/Allpaca</RepositoryUrl>
    <!-- MinVer: Version kommt aus dem Git-Tag (v1.5.1 → 1.5.1).
         Kein manuelles Hochzählen mehr in der csproj. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>
</Project>
