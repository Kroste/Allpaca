<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xunit.v3 generiert einen eigenen Entry-Point, das Testprojekt ist eine Exe. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xunit.v3 läuft auf der Microsoft.Testing.Platform. Das .NET-10-SDK
         unterstützt den alten VSTest-Pfad nicht mehr, deshalb ist das Opt-in
         hier Pflicht - ohne das bricht "dotnet test" mit MTP-Fehler ab. -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- xunit.v3 bringt den Microsoft.Testing.Platform-Runner selbst mit.
         Microsoft.NET.Test.Sdk und xunit.runner.visualstudio gehören zum alten
         VSTest-Pfad und würden ihn wieder aktivieren - deshalb bewusst NICHT hier. -->
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Allpaca\Allpaca.csproj" />
  </ItemGroup>

</Project>
